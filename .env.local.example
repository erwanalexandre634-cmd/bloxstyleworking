# ============================================
# ROBLOX OAUTH
# Create at: https://create.roblox.com/dashboard/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/roblox
# ============================================
ROBLOX_CLIENT_ID=your_client_id_here
ROBLOX_CLIENT_SECRET=your_client_secret_here

# ============================================
# DATABASE (PostgreSQL)
# Supabase: https://supabase.com
# Neon: https://neon.tech
# Example: postgresql://postgres.xxxxx:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# ============================================
DATABASE_URL="postgresql://user:password@host:5432/bloxstyle"

# ============================================
# REDIS (Upstash)
# https://upstash.com
# ============================================
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ============================================
# NEXTAUTH
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Or use: openssl rand -base64 32
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_super_secret_key_min_32_chars

# ============================================
# OPTIONAL
# ============================================
# Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Sentry (error tracking)
SENTRY_DSN=
