# ============================================
# BLOXSTYLE - Configuration
# ============================================

# --------------------------------------------------
# DATABASE (Neon PostgreSQL)
# https://neon.tech → Create Project → Connection String
# --------------------------------------------------
DATABASE_URL="postgresql://user:password@host/bloxstyle?sslmode=require"

# --------------------------------------------------
# SESSION SECRET
# Générer avec PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
# --------------------------------------------------
SESSION_SECRET="your-secret-key-at-least-32-characters-long"

# Alias pour compatibilité
NEXTAUTH_SECRET="your-secret-key-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# --------------------------------------------------
# ROBLOX OAUTH
# https://create.roblox.com/dashboard/credentials → OAuth 2.0 Apps → Create
# Redirect URL: http://localhost:3000/api/roblox/callback
# Permissions: openid, profile
# --------------------------------------------------
ROBLOX_CLIENT_ID="your-roblox-client-id"
ROBLOX_CLIENT_SECRET="your-roblox-client-secret"
